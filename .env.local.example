# Supabase bulut senkronu (opsiyonel).
# Bu iki değeri doldurup dosyayı ".env.local" olarak kaydedince bulut devreye girer.
# Boş bırakırsanız uygulama localStorage ile (sadece bu cihazda) çalışır.
#
# Değerleri Supabase panelinde bulursunuz:
#   Project Settings > API > Project URL  ve  Project API keys > anon public

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
